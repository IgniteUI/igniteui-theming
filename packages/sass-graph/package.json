  "version": "0.0.0",
  "description": "Interactive dependency map and impact explorer for the igniteui-theming Sass library.",
  "type": "module",
  "scripts": {
    "graph:build": "tsx scripts/build-graph.ts",
    "flow": "tsx scripts/cli.ts flow",
