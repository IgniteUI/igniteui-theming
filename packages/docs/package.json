{
  "name": "@igniteui-theming/docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation site for Ignite UI Theming, built with Astro.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist && node scripts/copy-llms-files.mjs dist",
    "preview": "astro preview",
    "check": "astro check",
    "fonts": "node scripts/subset-fonts.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:style": "stylelint \"**/*.{css,scss}\"",
    "format": "prettier --write \"**/*.{js,mjs,jsx,ts,tsx,astro,css,scss,md}\"",
    "lint": "npm run lint:style && npm run check",
    "clean": "shx rm -rf dist .astro"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx,astro,css,scss,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/react": "^7.1.5",
    "@codesandbox/sandpack-react": "^2.20.0",
    "@codesandbox/sandpack-themes": "^2.0.21",
    "@shikijs/rehype": "^4.0.2",
    "astro": "^7.4.8",
    "clsx": "^2.0.0",
    "github-slugger": "^2.0.0",
    "igniteui-theming": "*",
    "igniteui-webcomponents": "^7.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-directive": "^4.0.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@igniteui/material-icons-extended": "^3.1.0",
    "@shikijs/transformers": "^4.0.2",
    "@types/node": "^25.9.9",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.3.0",
    "cookie": "^2.0.2",
    "gray-matter": "^4.0.3",
    "pagefind": "^1.5.2",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^1.1.0",
    "sass": "^1.108.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-prettier": "^5.1.0",
    "stylelint-scss": "^7.4.0",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.0"
  }
}
