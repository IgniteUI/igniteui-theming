---
// Header of the core-concept overview pages (used from MDX): label, title, description and a themed
// illustration. Both illustrations are rendered and CSS shows one per theme, so no JavaScript is needed.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { localeFrom } from '../../lib/docs/config';
import { translator } from '../../lib/i18n/Translate';
import styles from './styles.module.scss';

interface Props {
  title: string;
  description: string;
  image: string;
}
const { title, description, image } = Astro.props;
const t = translator(localeFrom(Astro.currentLocale));
// The illustration files stay in `public/svg/logos` (the landing page fetches them by URL too); importing them
// here gives the header their intrinsic size.
const logos = import.meta.glob<ImageMetadata>(
  '../../../public/svg/logos/{,light/}*.svg',
  { eager: true, import: 'default' }
);
const dark = logos[`../../../public/svg/logos/${image}`];
const light = logos[`../../../public/svg/logos/light/${image}`];
if (!dark || !light)
  throw new Error(`Unknown core-concept illustration: ${image}`);
---

<div class={styles.doc__header}>
  <div class={styles.doc__header__wrapper}>
    <span>{t({ id: 'coreConcepts.title', message: 'CORE CONCEPTS' })}</span>
    <h1>{title}</h1>
    <p>{description}</p>
  </div>
  <div class={styles.doc__header__image}>
    <Image
      class={styles.doc__header__image__dark}
      src={dark}
      alt={title}
      title={title}
    />
    <Image
      class={styles.doc__header__image__light}
      src={light}
      alt={title}
      title={title}
    />
  </div>
</div>
