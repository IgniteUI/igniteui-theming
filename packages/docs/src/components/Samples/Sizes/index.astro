---
// Astro wrapper: hydrates the React Sandpack sample in `index.tsx` as a client-only island. MDX imports
// `@/components/Samples/Sizes`; the resolver in astro.config.mjs maps that to this file.
// `--it-sample-height` reserves the rendered height (measured at 1440px) until the island mounts, avoiding
// layout shift.
import Sample from './index.tsx';
---

<div class="it-sample" data-sample="Sizes" style="--it-sample-height: 623px">
  <Sample client:only="react" />
</div>
