---
// Admonitions: the `it-alert*` markup, icons, default (translated) titles and the
// type aliases (secondary → note, important → info, success → tip; caution keeps the warning styles).
// Rich titles (`:::note[**bold**]`) are not used in the content; only text titles are supported here.
import { localeFrom } from '../../lib/docs/config';
import { translator } from '../../lib/i18n/Translate';
import styles from './Admonition.module.css';

interface Props {
  type: string;
  title?: string;
  className?: string;
  id?: string;
}
const { type, title: titleProp, className, id } = Astro.props;
const t = translator(localeFrom(Astro.currentLocale));

const ICONS: Record<string, string> = {
  note: '<svg viewBox="0 0 14 16"> <path fill-rule="evenodd" d="M6.3 5.69a.942.942 0 0 1-.28-.7c0-.28.09-.52.28-.7.19-.18.42-.28.7-.28.28 0 .52.09.7.28.18.19.28.42.28.7 0 .28-.09.52-.28.7a1 1 0 0 1-.7.3c-.28 0-.52-.11-.7-.3zM8 7.99c-.02-.25-.11-.48-.31-.69-.2-.19-.42-.3-.69-.31H6c-.27.02-.48.13-.69.31-.2.2-.3.44-.31.69h1v3c.02.27.11.5.31.69.2.2.42.31.69.31h1c.27 0 .48-.11.69-.31.2-.19.3-.42.31-.69H8V7.98v.01zM7 2.3c-3.14 0-5.7 2.54-5.7 5.68 0 3.14 2.56 5.7 5.7 5.7s5.7-2.55 5.7-5.7c0-3.15-2.56-5.69-5.7-5.69v.01zM7 .98c3.86 0 7 3.14 7 7s-3.14 7-7 7-7-3.12-7-7 3.14-7 7-7z" /> </svg>',
  tip: '<svg viewBox="0 0 12 16"> <path fill-rule="evenodd" d="M6.5 0C3.48 0 1 2.19 1 5c0 .92.55 2.25 1 3 1.34 2.25 1.78 2.78 2 4v1h5v-1c.22-1.22.66-1.75 2-4 .45-.75 1-2.08 1-3 0-2.81-2.48-5-5.5-5zm3.64 7.48c-.25.44-.47.8-.67 1.11-.86 1.41-1.25 2.06-1.45 3.23-.02.05-.02.11-.02.17H5c0-.06 0-.13-.02-.17-.2-1.17-.59-1.83-1.45-3.23-.2-.31-.42-.67-.67-1.11C2.44 6.78 2 5.65 2 5c0-2.2 2.02-4 4.5-4 1.22 0 2.36.42 3.22 1.19C10.55 2.94 11 3.94 11 5c0 .66-.44 1.78-.86 2.48zM4 14h5c-.23 1.14-1.3 2-2.5 2s-2.27-.86-2.5-2z" /> </svg>',
  info: '<svg viewBox="0 0 14 16"> <path fill-rule="evenodd" d="M7 2.3c3.14 0 5.7 2.56 5.7 5.7s-2.56 5.7-5.7 5.7A5.71 5.71 0 0 1 1.3 8c0-3.14 2.56-5.7 5.7-5.7zM7 1C3.14 1 0 4.14 0 8s3.14 7 7 7 7-3.14 7-7-3.14-7-7-7zm1 3H6v5h2V4zm0 6H6v2h2v-2z" /> </svg>',
  warning:
    '<svg viewBox="0 0 16 16"> <path fill-rule="evenodd" d="M8.893 1.5c-.183-.31-.52-.5-.887-.5s-.703.19-.886.5L.138 13.499a.98.98 0 0 0 0 1.001c.193.31.53.501.886.501h13.964c.367 0 .704-.19.877-.5a1.03 1.03 0 0 0 .01-1.002L8.893 1.5zm.133 11.497H6.987v-2.003h2.039v2.003zm0-3.004H6.987V5.987h2.039v4.006z" /> </svg>',
  danger:
    '<svg viewBox="0 0 20 18"> <path d="M0 17.5L10.1345 0L20.269 17.5H0ZM2.5845 16H17.6845L10.1345 3L2.5845 16ZM10.1345 14.8077C10.3633 14.8077 10.5552 14.7303 10.71 14.5755C10.8648 14.4207 10.9423 14.2288 10.9423 14C10.9423 13.7712 10.8648 13.5793 10.71 13.4245C10.5552 13.2697 10.3633 13.1923 10.1345 13.1923C9.90567 13.1923 9.71383 13.2697 9.559 13.4245C9.40417 13.5793 9.32675 13.7712 9.32675 14C9.32675 14.2288 9.40417 14.4207 9.559 14.5755C9.71383 14.7303 9.90567 14.8077 10.1345 14.8077ZM9.3845 12.1923H10.8845V7.19225H9.3845V12.1923Z" /> </svg>',
};
const TYPES: Record<
  string,
  { className: string; icon: string; titleId: string; title: string }
> = {
  note: {
    className: 'it-alert it-alert--secondary',
    icon: 'note',
    titleId: 'theme.admonition.note',
    title: 'note',
  },
  tip: {
    className: 'it-alert it-alert--success',
    icon: 'tip',
    titleId: 'theme.admonition.tip',
    title: 'tip',
  },
  info: {
    className: 'it-alert it-alert--info',
    icon: 'info',
    titleId: 'theme.admonition.info',
    title: 'info',
  },
  warning: {
    className: 'it-alert it-alert--warning',
    icon: 'warning',
    titleId: 'theme.admonition.warning',
    title: 'warning',
  },
  danger: {
    className: 'it-alert it-alert--danger',
    icon: 'danger',
    titleId: 'theme.admonition.danger',
    title: 'danger',
  },
  caution: {
    className: 'it-alert it-alert--warning',
    icon: 'warning',
    titleId: 'theme.admonition.caution',
    title: 'caution',
  },
};
// Undocumented aliases keep a hardcoded, untranslated label.
const ALIASES: Record<string, { base: string; title: string }> = {
  secondary: { base: 'note', title: 'secondary' },
  important: { base: 'info', title: 'important' },
  success: { base: 'tip', title: 'success' },
};

const alias = ALIASES[type];
const config = TYPES[alias?.base ?? type] ?? TYPES.info!;
if (!TYPES[type] && !alias) {
  console.warn(
    `No admonition component found for admonition type "${type}". Using Info as fallback.`
  );
}
const title =
  titleProp ?? alias?.title ?? t({ id: config.titleId, message: config.title });
const content = (await Astro.slots.render('default')).trim();
---

<div
  class:list={[styles.admonition, config.className, className, 'it-alert']}
  id={id}
>
  <div class:list={[styles.admonitionHeading, 'it-alert__heading']}>
    <span
      class:list={[styles.admonitionIcon, 'it-alert__icon']}
      set:html={ICONS[config.icon]}
    />
    {title}
  </div>
  {content && (
    <div
      class:list={[styles.admonitionContent, 'it-alert__content']}
      set:html={content}
    />
  )}
</div>
