{
    "trailingComma": "es5",
    "tabWidth": 2,
    "singleQuote": true,
    "arrowParens": "always",
    "plugins": [
        "prettier-plugin-astro"
    ],
    "overrides": [
        {
            "files": "*.astro",
            "options": {
                "parser": "astro"
            }
        }
    ]
}
